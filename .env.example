POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://botcrm:replace_me@localhost:5432/botcrm
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
# Public HTTPS S3 endpoint reachable by Telegram/WhatsApp for outbound media
S3_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=botcrm
MINIO_ROOT_PASSWORD=replace_me
S3_BUCKET=botcrm-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Для внешнего S3 можно задать S3_ENDPOINT, S3_ACCESS_KEY_ID и S3_SECRET_ACCESS_KEY.
SERVICE_TOKEN=replace_with_32_random_bytes
SERVICE_TOKEN_WORKSPACE_ID=ws_demo
MASTER_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
BOOTSTRAP_OWNER_EMAIL=owner@botcrm.local
BOOTSTRAP_OWNER_PASSWORD=replace_with_at_least_12_random_characters
PUBLIC_API_URL=http://localhost:4100/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
# Authentication is secure by default. Never enable ALLOW_INSECURE_AUTH_BYPASS outside an isolated local machine.
AUTH_REQUIRED=true
ALLOW_INSECURE_AUTH_BYPASS=false
# Enable only behind a trusted reverse proxy which overwrites X-Forwarded-For.
TRUST_PROXY=false
# Distributed API rate limiting (Redis, with a per-process fallback).
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_ROUTE_RATE_LIMIT_IP_MAX=20
LOGIN_ROUTE_RATE_LIMIT_IP_WINDOW_SECONDS=60
LOGIN_ROUTE_RATE_LIMIT_EMAIL_MAX=10
LOGIN_ROUTE_RATE_LIMIT_EMAIL_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_PAIR_MAX=5
LOGIN_RATE_LIMIT_EMAIL_MAX=10
LOGIN_RATE_LIMIT_IP_MAX=30
WEBHOOK_RATE_LIMIT_MAX=3000
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS=true
# Optional outbound proxy for Telegram/VK/WhatsApp/Avito when direct access is blocked
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
AUTOMATION_WEBHOOK_ALLOWLIST=hooks.example.com
AUTOMATION_WEBHOOK_SECRET=replace-with-random-secret
BOTCRM_API_URL=http://localhost:4100/api/v1
INACTIVITY_SCAN_INTERVAL_MS=60000
MESSAGE_CONCURRENCY=30
CAMPAIGN_CONCURRENCY=20
CAMPAIGN_RATE_LIMIT=30

# Signed Gateway/Mirror callbacks to custom bots
BOT_EVENT_SIGNING_SECRET=replace-with-a-random-32-character-secret
BOT_EVENT_ALLOW_HTTP=false
BOT_EVENT_CONCURRENCY=20

SCHEDULED_CAMPAIGN_SCAN_INTERVAL_MS=30000

# Technical data retention (business messages are not deleted)
RETENTION_SCAN_INTERVAL_MS=21600000
RAW_WEBHOOK_RETENTION_DAYS=30
INGESTED_EVENT_RETENTION_DAYS=30
PROCESSED_OUTBOX_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365
MESSAGE_RECOVERY_SCAN_INTERVAL_MS=15000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_password

# Local Telegram end-to-end test bot
TELEGRAM_TEST_BOT_TOKEN=
# Optional dedicated token; falls back to SERVICE_TOKEN when empty
TELEGRAM_TEST_BOTCRM_TOKEN=
TELEGRAM_TEST_BOTCRM_URL=http://localhost:4100
TELEGRAM_TEST_WORKSPACE_ID=ws_demo
TELEGRAM_TEST_BOT_SLUG=telegram_test_bot
TELEGRAM_TEST_BOT_PORT=4310
TELEGRAM_TEST_BOT_CALLBACK_SECRET=replace_with_a_random_secret_of_at_least_32_characters