# Ключ доступа сообщества с правом управления сообщениями.
VK_TEST_BOT_TOKEN=

# Числовой ID сообщества без минуса. Например, для club123456 это 123456.
VK_TEST_GROUP_ID=
VK_TEST_API_VERSION=5.199

# Необязательно: отдельный сервисный токен BotCRM.
# Если оставить пустым, используется корневой SERVICE_TOKEN.
VK_TEST_BOTCRM_TOKEN=

VK_TEST_BOTCRM_URL=https://crm.example.com
VK_TEST_WORKSPACE_ID=ws_demo
VK_TEST_BOT_SLUG=vk_test_bot

# Необязательно для Mirror / Bots Long Poll. Нужен только при заполненном
# endpoint событий оператора в карточке подключения BotCRM.
VK_TEST_BOT_PORT=4320
VK_TEST_BOT_CALLBACK_SECRET=
