# Скопируйте эти переменные в корневой файл .env проекта.

# Токен, выданный @BotFather. Один и тот же токен вставляется в подключение Telegram в BotCRM.
TELEGRAM_TEST_BOT_TOKEN=

# Необязательно: отдельный сервисный токен из «Настройки → Сервисные токены».
# Если оставить пустым, бот использует корневой SERVICE_TOKEN.
TELEGRAM_TEST_BOTCRM_TOKEN=

TELEGRAM_TEST_BOTCRM_URL=http://localhost:4100
TELEGRAM_TEST_WORKSPACE_ID=ws_demo
TELEGRAM_TEST_BOT_SLUG=telegram_test_bot
TELEGRAM_TEST_BOT_PORT=4310

# Должен совпадать с полем «Webhook secret token» при создании подключения в BotCRM.
TELEGRAM_TEST_BOT_CALLBACK_SECRET=replace_with_a_random_secret_of_at_least_32_characters
