# Public DNS names. Create A/AAAA records for both names before first start.
BOTCRM_DOMAIN=crm.example.com
BOTCRM_STORAGE_DOMAIN=media.crm.example.com
ACME_EMAIL=admin@example.com

# Initial workspace and owner. The password is only applied when the owner is first created.
BOOTSTRAP_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
BOOTSTRAP_WORKSPACE_NAME=Bot Studio
BOOTSTRAP_WORKSPACE_TIMEZONE=Europe/Moscow
BOOTSTRAP_OWNER_NAME=Владелец
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-random-password-of-at-least-16-characters

# Generate independent random values. Do not reuse these secrets.
POSTGRES_PASSWORD=replace-with-a-random-32-character-secret
REDIS_PASSWORD=replace-with-a-random-32-character-secret
MINIO_ROOT_USER=botcrm
MINIO_ROOT_PASSWORD=replace-with-a-random-32-character-secret
SERVICE_TOKEN=replace-with-a-random-48-character-secret
SERVICE_TOKEN_WORKSPACE_ID=ws_demo
MASTER_ENCRYPTION_KEY=replace-with-a-random-48-character-secret
BOT_EVENT_SIGNING_SECRET=replace-with-a-random-48-character-secret
AUTOMATION_WEBHOOK_SECRET=replace-with-a-random-48-character-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-24-character-password

# Security and session policy.
AUTH_REQUIRED=true
ALLOW_INSECURE_AUTH_BYPASS=false
TRUST_PROXY=true
SESSION_TTL_HOURS=168
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_ROUTE_RATE_LIMIT_IP_MAX=20
LOGIN_ROUTE_RATE_LIMIT_IP_WINDOW_SECONDS=60
LOGIN_ROUTE_RATE_LIMIT_EMAIL_MAX=10
LOGIN_ROUTE_RATE_LIMIT_EMAIL_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_PAIR_MAX=5
LOGIN_RATE_LIMIT_EMAIL_MAX=10
LOGIN_RATE_LIMIT_IP_MAX=30
WEBHOOK_RATE_LIMIT_MAX=3000
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS=true

# Delivery and automation.
DELIVERY_MODE=live
AUTOMATION_WEBHOOK_ALLOWLIST=
BOT_EVENT_ALLOW_HTTP=false
MESSAGE_CONCURRENCY=30
CAMPAIGN_CONCURRENCY=20
CAMPAIGN_RATE_LIMIT=30
BOT_EVENT_CONCURRENCY=20
INACTIVITY_SCAN_INTERVAL_MS=60000
SCHEDULED_CAMPAIGN_SCAN_INTERVAL_MS=30000
MESSAGE_RECOVERY_SCAN_INTERVAL_MS=15000
BOT_EVENT_RECOVERY_SCAN_INTERVAL_MS=15000

# Retention. Business messages and CRM records are kept until explicit deletion.
RETENTION_SCAN_INTERVAL_MS=21600000
RAW_WEBHOOK_RETENTION_DAYS=30
INGESTED_EVENT_RETENTION_DAYS=30
PROCESSED_OUTBOX_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365

# Optional outbound proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,minio,api,web