[Unit]
Description=Encrypted BotCRM backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=%i
Group=%i
WorkingDirectory=/opt/botcrm
EnvironmentFile=/opt/botcrm/.backup.env
UMask=0077
ExecStart=/usr/bin/npm run prod:backup
ExecStart=/usr/bin/find /opt/botcrm/backups -maxdepth 1 -type f -name botcrm-*.botcrm-backup -mtime +14 -delete
NoNewPrivileges=true
PrivateTmp=true

