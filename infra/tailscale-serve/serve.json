{
  "TCP": {
    "443": {
      "TCPForward": "botcrm-edge-1:8081",
      "TerminateTLS": "${TS_CERT_DOMAIN}",
      "ProxyProtocol": 2
    },
    "8443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": {
        "/": {
          "Proxy": "http://minio:9000"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true,
    "${TS_CERT_DOMAIN}:8443": true
  }
}
